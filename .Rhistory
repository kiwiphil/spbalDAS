set.seed(2026)
# 1000 points uniformly in [0,1)^2
myLocations <- matrix(runif(2000 * 2), ncol = 2)
n = 100;
J = 200;
# candidate samples
sampleMatrix = DAS(myLocations, n, J)
#sampleMatrix = DAS(myLocations, n);
# first candidate sample
s = sampleMatrix[1,];
s
library(ggplot2)
library(reshape2)
# ====================== UPDATED PLOT WITH DYNAMIC TITLE ======================
index_matrix <- sampleMatrix          # leave original intact
df <- myLocations
# Melt and merge
index_long <- reshape2::melt(index_matrix)
colnames(index_long) <- c("row", "col", "index")
plot_data <- merge(index_long, df, by.x = "index", by.y = "row.names", all.x = TRUE)
# Color group
plot_data$color_group <- ifelse(plot_data$row == 1, "First row", "Other rows")
# Ensure red points are drawn last (on top)
plot_data <- plot_data[order(plot_data$color_group), ]
# Dynamic title + caption
num_locations <- length(myLocations) / 2
ggplot(plot_data, aes(x = V1, y = V2, color = color_group)) +
geom_point(size = 3, alpha = 0.9) +
scale_color_manual(values = c("Other rows" = "black", "First row" = "red")) +
theme_minimal(base_size = 14) +
labs(title = paste0("DAS Sample of n = ", n, " from ", num_locations, " Locations"),
subtitle = "First row of SampleMatrix shown in red (drawn on top)",
color = "Matrix Row Group",
caption = paste0("Red points are always on top | Total locations = ", num_locations)) +
xlab("X Coordinate") +
ylab("Y Coordinate") +
theme(legend.position = "right")
