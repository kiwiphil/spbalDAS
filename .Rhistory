C_fast[1,]
# Test
# Small test
set.seed(123)
W <- matrix(runif(10*10), 10, 10)
W <- W + t(W)  # make symmetric
diag(W) <- 0
sSampleMatrix <- matrix(sample(1:10, 20*10, replace = TRUE), nrow = 20)
# Original slow way (uncomment your rSBMoranIvec line)
C_slow <- matrix(0, 20, 20)
for (i in 1:20) {
C_slow[i, ] <- rSBMoranIvecNew(as.vector(sSampleMatrix[i,1:9]), as.vector(sSampleMatrix[i,10]), as.matrix(W))
}
rSBMoranIvecBatch <- function(C, A_vec, W) {
# C: vector of nodes in the cluster (fixed)
# A_vec: vector of many outside nodes (one per sample, length nSamples)
# W: weight matrix
internal <- sum(W[C, C])  # scalar, same for all
# W[A_vec, C]: rows = each a in A_vec, columns = nodes in C
out_sum <- rowSums(as.matrix(W[A_vec, C]))   # A_vec → C
# W[C, A_vec]: rows = C, columns = each a
in_sum <- colSums(as.matrix(W[C, A_vec]))    # C → A_vec
result <- internal + out_sum + in_sum
return(result)
}
# new slow:
nSamples <- nrow(sSampleMatrix)
C_slow <- matrix(0, nSamples, nSamples)
for (i in 1:nSamples) {
C_i <- as.vector(sSampleMatrix[i, 1:9])     # cluster for sample i
A_all <- sSampleMatrix[, 10]                 # all outside nodes (column 10 across all samples)
C_slow[i, ] <- rSBMoranIvecBatch(C_i, A_all, W)
}
# Fast way
C_fast <- cppSBMoranIvecNew(sSampleMatrix[,1:9], sSampleMatrix[,10], W)
all.equal(C_slow, C_fast)  # Should be TRUE
n = 20;
# candidate samples
sampleMatrix = DAS(myLocations, n);
C_slow[1,]
