library(clue)
my_matrix <- matrix(sample(0:500, 1000000, replace = TRUE), nrow = 1000, ncol = 1000)
newpop <- my_matrix
pop <- my_matrix
newpop <- matrix(pop, ncol = 2, byrow = TRUE)
n <- 20
sampMx <- DAS(newpop, n, verbose = FALSE)
sampMx <- DAS(newpop, n, J1 = 200, verbose = FALSE)
n <- 100
sampMx <- DAS(newpop, n, J1 = 100, verbose = FALSE)
sampMx <- DAS(newpop, n, J1 = 20, verbose = FALSE)
my_matrix <- matrix(sample(0:500, 10000, replace = TRUE), nrow = 100, ncol = 100)
pop <- my_matrix
newpop <- matrix(pop, ncol = 2, byrow = TRUE)
n <- 100
sampMx <- DAS(newpop, n, J1 = 20, verbose = FALSE)
sampMx <- DAS(newpop, n, J1 = 100, verbose = FALSE)
# color by row.
sampMx[1:20]
# verify number of unique values in sampMx is the same as the number of obs. in newpop
(length(unique(sampMx)) == dim(newpop)[1])
# plotting...
index_matrix <- sampMx
df <- newpop
# Melt the matrix into long format to map indices to colors
index_long <- melt(index_matrix)
colnames(index_long) <- c("row", "col", "index")
# Melt the matrix into long format to map indices to colors
library(reshape2)
index_long <- melt(index_matrix)
colnames(index_long) <- c("row", "col", "index")
# Merge the matrix data with the dataframe coordinates
plot_data <- merge(index_long, df, by.x = "index", by.y = "row.names")
# Create a color column for the row groups of the matrix
plot_data$color_group <- ifelse(plot_data$row == 1, "red", "black")
# Plot the points, colored by the row group of the matrix
ggplot(plot_data, aes(x = V1, y = V2, color = color_group)) +
scale_color_manual(values=c("black", "red")) +
geom_point(size = 3) +
theme_minimal() +
labs(color = "Matrix Row Group", title = "DAS Example - Colored Points by Matrix Rows",
subtitle = "100 point pairs, n = 10.",
caption = "First row colored in RED.") +
xlab("X Coordinate") +
ylab("Y Coordinate")
