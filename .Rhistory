# Sample centroids on top — red with black outline
points(centroids[,1], centroids[,2],
col = "black",
bg  = "red",
pch = 18,
cex = 1.6,
lwd = 1.3)
# 1. Prepare the 100 sample centroids
sample_idx <- sampleMatrix[1, ]
centroids  <- as.data.frame(myLocations[sample_idx, , drop = FALSE])
# 2. Compute Voronoi tessellation
vor   <- deldir(x = centroids[[1]], y = centroids[[2]])
tiles <- tile.list(vor)
# 3. Build vor_df using simple vectors (this fixes every colnames/fortify issue)
x_all     <- numeric()
y_all     <- numeric()
group_all <- integer()
for (i in seq_along(tiles)) {
tile <- tiles[[i]]
# Skip any degenerate tile
if (!is.list(tile) || length(tile$x) < 3 || length(tile$y) < 3) next
if (length(tile$x) != length(tile$y)) next
px <- tile$pt[["x"]]
py <- tile$pt[["y"]]
if (!is.finite(px) || !is.finite(py)) next
poly_x <- c(px, tile$x, px)
poly_y <- c(py, tile$y, py)
x_all     <- c(x_all, poly_x)
y_all     <- c(y_all, poly_y)
group_all <- c(group_all, rep(i, length(poly_x)))
}
vor_df <- data.frame(
x     = x_all,
y     = y_all,
group = group_all,
stringsAsFactors = FALSE,
check.names = FALSE
)
# Force a completely clean data.frame
vor_df <- as.data.frame(vor_df)
rownames(vor_df) <- NULL
colnames(vor_df) <- c("x", "y", "group")
# Diagnostics (you should see 100 valid cells)
cat("Total tiles from deldir :", length(tiles), "\n")
cat("Valid Voronoi cells    :", length(unique(vor_df$group)), "\n")
str(vor_df)   # ← shows the structure so we can confirm it's perfect
# 4. Plot
ggplot() +
# Voronoi cells – single light colour
geom_polygon(data = vor_df,
aes(x = x, y = y, group = group),
fill = "lightblue", alpha = 0.3,
colour = "grey60", linewidth = 0.4) +
# All myLocations points – black
#geom_point(data = myLocations,
#           aes(x = myLocations[[1]], y = myLocations[[2]]),
#           color = "black", size = 1.1, alpha = 0.75, shape = 16) +
# Sample centroids – red
geom_point(data = centroids,
aes(x = centroids[[1]], y = centroids[[2]]),
color = "black", fill = "red", size = 4.5, shape = 21, stroke = 1.3) +
coord_equal() +
theme_minimal(base_size = 13) +
theme(
legend.position = "none",
panel.grid   = element_blank(),
axis.title   = element_blank(),
axis.text    = element_blank()
) +
labs(title = "Voronoi diagram from sample points")
set.seed(2026)
# 1000 points uniformly in [0,1)^2
myLocations <- matrix(runif(5000 * 2), ncol = 2)
n = 200;
J1 = 100;
# candidate samples
sampleMatrix = DAS(myLocations, n, J1, n_threads = 0);
# first candidate sample
s = sampleMatrix[1,];
s
library(reshape2)
library(ggplot2)
# plotting...
index_matrix <- sampleMatrix # leave sampleMatrix intact
df <- myLocations
# Melt the matrix into long format to map indices to colors
index_long <- melt(index_matrix)
colnames(index_long) <- c("row", "col", "index")
# Merge the matrix data with the dataframe coordinates
plot_data <- merge(index_long, df, by.x = "index", by.y = "row.names")
# Create a color column for the row groups of the matrix
plot_data$color_group <- ifelse(plot_data$row == 1, "red", "black")
# Dynamic title using the actual values of n and number of locations
n_value <- n
n_locations <- length(myLocations) / 2
# Plot the points - BLACK drawn first, RED on top (guaranteed layering)
ggplot(plot_data, aes(x = V1, y = V2, color = color_group)) +
# Black points (bottom layer)
geom_point(data = plot_data[plot_data$color_group == "black", ],
size = 3) +
# Red points (top layer - drawn after black)
geom_point(data = plot_data[plot_data$color_group == "red", ],
size = 3) +
scale_color_manual(values = c("black" = "black", "red" = "red")) +
theme_minimal() +
labs(color = "Matrix Row Group",
title = paste0("DAS Sample of n = ", n_value,
" from ", n_locations, " Locations"),
caption = "First row colored in RED.") +
xlab("X Coordinate") +
ylab("Y Coordinate")
