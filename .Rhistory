rownames(data_matrix) <- c("Point1", "Point2", "Point3")
# Calculate distance matrix (returns a 'dist' object)
d_matrix <- dist(data_matrix)
# Print the result (shows lower triangle by default)
print(d_matrix)
# Convert to a full matrix for better visibility
as.matrix(d_matrix)
